<?xml version="1.0"?>
<package format="3">
  <name>corgi_walk</name>
  <version>0.1.0</version>
  <description>Walk and trot gait algorithms for Corgi quadruped robot (ROS 2).</description>
  <maintainer email="r13522820@ntu.edu.tw">anne</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>corgi_msgs</depend>
  <depend>corgi_utils</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>corgi_odometry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
