<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corgi_orin_monitor</name>
  <version>1.0.0</version>
  <description>Always-on Orin health/power logger with fsync, plus a post-mortem report for unexpected reboots. Pure Python standard library; runs from systemd without ROS.</description>

  <maintainer email="angel.tl314@gmail.com">changtsailin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
