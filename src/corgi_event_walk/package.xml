<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corgi_event_walk</name>
  <version>0.1.0</version>
  <description>Event-driven sequential walk gait for the Corgi quadruped.</description>
  <maintainer email="annexiao1007@gmail.com">root</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>corgi_msgs</depend>
  <depend>corgi_utils</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>corgi_attitude_control</exec_depend>
  <exec_depend>corgi_odometry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
