<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corgi_vmc</name>
  <version>0.0.0</version>
  <description>Virtual Model Control for CORGI quadruped robot</description>
  <maintainer email="r12522823@ntu.edu.tw">yisyuan</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen3_cmake_module</depend>
  <depend>Eigen3</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>corgi_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>corgi_utils</depend>
  <depend>corgi_walk</depend>
  <depend>corgi_force_estimation</depend>
  <depend>corgi_gait_selector</depend>
  <depend>corgi_hybrid</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
